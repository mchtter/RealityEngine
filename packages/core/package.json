{
  "name": "@opentwin/city-core",
  "version": "0.1.0",
  "description": "OpenTwin city compiler: road graph, city blocks, building/prop generation rules (renderer independent)",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs,esm --dts",
    "dev": "tsup src/index.ts --format cjs,esm --dts --watch",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "fixture:zonguldak": "node tools/fetch-fixture.mjs"
  },
  "dependencies": {
    "clipper-lib": "^6.4.2",
    "earcut": "^2.2.4"
  },
  "devDependencies": {
    "geotiff": "^3.0.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3",
    "vitest": "^4.1.10",
    "@types/clipper-lib": "^6.4.0"
  }
}
