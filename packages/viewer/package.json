{
  "name": "reality-engine-viewer",
  "version": "0.1.0",
  "description": "Reality Engine 3D procedural city engine: Three.js WebGPU/WebGL2 runtime viewer",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts src/tile.worker.ts --format esm --dts",
    "dev": "tsup src/index.ts src/tile.worker.ts --format esm --dts --watch",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "reality-engine-core": "workspace:*",
    "reality-engine-geo": "workspace:*",
    "three": "^0.183.2"
  },
  "devDependencies": {
    "@types/three": "^0.183.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.3"
  }
}
